# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# VITE_GOOGLE_MAPS_API_KEY: browser key for Maps JavaScript, Places, Geocoding,
# Distance Matrix, and Maps Static APIs. Enable those APIs and restrict the key
# to this website's HTTP referrers.
VITE_GOOGLE_MAPS_API_KEY="MY_GOOGLE_MAPS_API_KEY"

# GOOGLE_MAPS_SERVER_KEY: optional server key for authoritative Distance Matrix
# pricing in the Paystack gateway. Keep this server-side only. Without it, the
# gateway uses the shared distance estimate from restaurant/customer coordinates.
GOOGLE_MAPS_SERVER_KEY="MY_GOOGLE_MAPS_SERVER_KEY"

# Paystack gateway configuration.
# VITE_PAYSTACK_PUBLIC_KEY is safe to expose to the browser. Keep the secret and webhook keys server-side only.
VITE_PAYSTACK_PUBLIC_KEY="pk_test_xxxxxxxxxxxxxxxx"
PAYSTACK_SECRET_KEY="sk_test_xxxxxxxxxxxxxxxx"
PAYSTACK_WEBHOOK_SECRET="whsec_xxxxxxxxxxxxxxxx"

# Firebase Admin credentials used by the gateway to verify ID tokens and finalize orders.
# Paste a service account JSON object as a single line, or set GOOGLE_APPLICATION_CREDENTIALS to a file path.
FIREBASE_SERVICE_ACCOUNT='{"type":"service_account","project_id":"...","private_key":"...","client_email":"..."}'
# GOOGLE_APPLICATION_CREDENTIALS="/absolute/path/to/service-account.json"
FIREBASE_FIRESTORE_DATABASE_ID="ai-studio-calabarfoodmarke-ad39e5a3-c3ad-48b4-bd40-1db033f8742a"

# Gateway server settings.
# PAYMENT_API_TARGET is used by the Vite dev proxy. In production, serve dist/ with the gateway on the same origin.
PORT="3001"
PAYMENT_API_TARGET="http://localhost:3001"
PAYMENT_CORS_ORIGIN="*"
PAYMENT_RETURN_URL="http://localhost:3000/#checkout"
