{
  "entities": {
    "AdminUser": {
      "title": "AdminUser",
      "description": "Authorized marketplace administrator record.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "email": {
          "type": "string",
          "format": "email",
          "maxLength": 180
        },
        "name": {
          "type": "string",
          "maxLength": 120
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["uid", "email", "name", "createdAt"]
    },
    "GeoPoint": {
      "title": "GeoPoint",
      "description": "Latitude and longitude pair used for restaurant and delivery locations.",
      "type": "object",
      "properties": {
        "lat": {
          "type": "number",
          "minimum": -90,
          "maximum": 90
        },
        "lng": {
          "type": "number",
          "minimum": -180,
          "maximum": 180
        }
      },
      "required": ["lat", "lng"]
    },
    "UserSummary": {
      "title": "UserSummary",
      "description": "Marketplace user account role and non-PII summary.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "displayName": {
          "type": "string",
          "maxLength": 120
        },
        "role": {
          "type": "string",
          "enum": ["customer", "vendor", "admin"],
          "maxLength": 20
        },
        "accountStatus": {
          "type": "string",
          "enum": ["Active", "Suspended"],
          "maxLength": 20
        },
        "neighbourhood": {
          "type": "string",
          "maxLength": 80
        },
        "vendorRestaurantId": {
          "type": "string",
          "maxLength": 128
        },
        "totalOrders": {
          "type": "integer"
        },
        "totalSpent": {
          "type": "number"
        },
        "joinedAt": {
          "type": "string",
          "maxLength": 40
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["uid", "displayName", "role", "accountStatus", "neighbourhood", "totalOrders", "totalSpent", "joinedAt", "createdAt", "updatedAt"]
    },
    "UserPrivateInfo": {
      "title": "UserPrivateInfo",
      "description": "Isolated PII record for a user (email, phone, saved delivery addresses).",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "email": {
          "type": "string",
          "format": "email",
          "maxLength": 180
        },
        "phone": {
          "type": "string",
          "maxLength": 40
        },
        "savedAddresses": {
          "type": "array",
          "maxItems": 10,
          "items": {
            "type": "object",
            "properties": {
              "id": { "type": "string", "maxLength": 128 },
              "label": { "type": "string", "maxLength": 60 },
              "street": { "type": "string", "maxLength": 240 },
              "neighbourhood": { "type": "string", "maxLength": 80 },
              "lat": { "type": "number", "minimum": -90, "maximum": 90 },
              "lng": { "type": "number", "minimum": -180, "maximum": 180 }
            },
            "required": ["id", "label", "street", "neighbourhood"]
          }
        },
        "notificationPreferences": {
          "type": "object",
          "properties": {
            "smsOrderAlerts": {
              "type": "boolean"
            },
            "emailReceipts": {
              "type": "boolean"
            }
          }
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["uid", "email", "phone", "savedAddresses", "updatedAt"]
    },
    "Restaurant": {
      "title": "Restaurant",
      "description": "Calabar restaurant storefront profile and operational settings.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "name": {
          "type": "string",
          "maxLength": 140
        },
        "cuisine": {
          "type": "string",
          "maxLength": 140
        },
        "categories": {
          "type": "array"
        },
        "restaurantCategories": {
          "type": "array"
        },
        "priceTier": {
          "type": "string",
          "enum": ["₦", "₦₦", "₦₦₦"],
          "maxLength": 10
        },
        "averageMealPrice": {
          "type": "number"
        },
        "neighbourhood": {
          "type": "string",
          "maxLength": 80
        },
        "address": {
          "type": "string",
          "maxLength": 240
        },
        "location": {
          "$ref": "#/entities/GeoPoint"
        },
        "description": {
          "type": "string",
          "maxLength": 600
        },
        "coverImage": {
          "type": "string",
          "maxLength": 400
        },
        "logoText": {
          "type": "string",
          "maxLength": 6
        },
        "deliveryTimeMin": {
          "type": "integer"
        },
        "deliveryTimeMax": {
          "type": "integer"
        },
        "deliveryFee": {
          "type": "number"
        },
        "minimumOrder": {
          "type": "number"
        },
        "openingHours": {
          "type": "string",
          "maxLength": 80
        },
        "isOpen": {
          "type": "boolean"
        },
        "status": {
          "type": "string",
          "enum": ["Active", "Suspended"],
          "maxLength": 20
        },
        "rating": {
          "type": "number"
        },
        "reviewCount": {
          "type": "integer"
        },
        "popularityScore": {
          "type": "integer"
        },
        "ownerUid": {
          "type": "string",
          "maxLength": 128
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["id", "name", "cuisine", "categories", "restaurantCategories", "priceTier", "averageMealPrice", "neighbourhood", "address", "description", "coverImage", "logoText", "deliveryTimeMin", "deliveryTimeMax", "deliveryFee", "minimumOrder", "openingHours", "isOpen", "status", "reviewCount", "popularityScore", "ownerUid", "createdAt", "updatedAt"]
    },
    "MenuItem": {
      "title": "MenuItem",
      "description": "Dish listed by a restaurant on the marketplace.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "restaurantId": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "ownerUid": {
          "type": "string",
          "maxLength": 128
        },
        "name": {
          "type": "string",
          "maxLength": 140
        },
        "description": {
          "type": "string",
          "maxLength": 500
        },
        "category": {
          "type": "string",
          "maxLength": 40
        },
        "menuSection": {
          "type": "string",
          "maxLength": 80
        },
        "price": {
          "type": "number"
        },
        "image": {
          "type": "string",
          "maxLength": 400
        },
        "available": {
          "type": "boolean"
        },
        "popular": {
          "type": "boolean"
        },
        "sizes": {
          "type": "array"
        },
        "extras": {
          "type": "array"
        },
        "toppings": {
          "type": "array"
        },
        "spiceLevels": {
          "type": "array"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["id", "restaurantId", "ownerUid", "name", "description", "category", "menuSection", "price", "image", "available", "createdAt", "updatedAt"]
    },
    "FoodCategoryDoc": {
      "title": "FoodCategoryDoc",
      "description": "Marketplace-wide food category configuration.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "maxLength": 64
        },
        "label": {
          "type": "string",
          "maxLength": 60
        },
        "subtitle": {
          "type": "string",
          "maxLength": 160
        },
        "image": {
          "type": "string",
          "maxLength": 400
        },
        "isActive": {
          "type": "boolean"
        },
        "sortOrder": {
          "type": "integer"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["id", "label", "subtitle", "image", "isActive", "sortOrder", "createdAt", "updatedAt"]
    },
    "Order": {
      "title": "Order",
      "description": "Customer food order with bounded line items and delivery metadata.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "orderNumber": {
          "type": "string",
          "maxLength": 40
        },
        "customerId": {
          "type": "string",
          "maxLength": 128
        },
        "customerName": {
          "type": "string",
          "maxLength": 120
        },
        "customerPhone": {
          "type": "string",
          "maxLength": 40
        },
        "deliveryAddress": {
          "type": "string",
          "maxLength": 240
        },
        "neighbourhood": {
          "type": "string",
          "maxLength": 80
        },
        "deliveryInstructions": {
          "type": "string",
          "maxLength": 300
        },
        "pickupLocation": {
          "$ref": "#/entities/GeoPoint"
        },
        "deliveryLocation": {
          "$ref": "#/entities/GeoPoint"
        },
        "deliveryDistanceKm": {
          "type": "number",
          "minimum": 0
        },
        "deliveryDurationMin": {
          "type": "number",
          "minimum": 0
        },
        "locationSource": {
          "type": "string",
          "enum": ["google", "osm", "estimated"],
          "maxLength": 20
        },
        "restaurantId": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "restaurantOwnerUid": {
          "type": "string",
          "maxLength": 128
        },
        "restaurantName": {
          "type": "string",
          "maxLength": 140
        },
        "restaurantAddress": {
          "type": "string",
          "maxLength": 240
        },
        "restaurantPhone": {
          "type": "string",
          "maxLength": 40
        },
        "items": {
          "type": "array"
        },
        "subtotal": {
          "type": "number"
        },
        "deliveryFee": {
          "type": "number"
        },
        "serviceCharge": {
          "type": "number"
        },
        "total": {
          "type": "number"
        },
        "status": {
          "type": "string",
          "maxLength": 40
        },
        "paymentStatus": {
          "type": "string",
          "enum": ["Paid", "Pending", "Refunded"],
          "maxLength": 20
        },
        "placedAt": {
          "type": "string",
          "maxLength": 60
        },
        "estimatedDelivery": {
          "type": "string",
          "maxLength": 60
        },
        "paymentMethod": {
          "type": "string",
          "maxLength": 40
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["id", "orderNumber", "customerId", "customerName", "customerPhone", "deliveryAddress", "neighbourhood", "restaurantId", "restaurantOwnerUid", "restaurantName", "restaurantPhone", "items", "subtotal", "deliveryFee", "serviceCharge", "total", "status", "paymentStatus", "placedAt", "estimatedDelivery", "paymentMethod", "createdAt", "updatedAt"]
    },
    "Transaction": {
      "title": "Transaction",
