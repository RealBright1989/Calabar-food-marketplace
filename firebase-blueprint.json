        "commissionAmount": {
          "type": "number"
        },
        "vendorPayout": {
          "type": "number"
        },
        "serviceCharge": {
          "type": "number"
        },
        "verificationStatus": {
          "type": "string",
          "enum": ["Pending Verification", "Verified", "Refunded"],
          "maxLength": 30
        },
        "verifiedByUid": {
          "type": "string",
          "maxLength": 128
        },
        "verifiedAt": {
          "type": "string",
          "maxLength": 60
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["id", "orderId", "orderNumber", "restaurantId", "restaurantOwnerUid", "restaurantName", "customerId", "customerName", "reference", "gateway", "type", "grossAmount", "subtotalAmount", "commissionRatePercent", "commissionAmount", "vendorPayout", "serviceCharge", "verificationStatus", "createdAt"]
    },
