        },
        "orderId": {
          "type": "string",
          "maxLength": 128
        },
        "orderNumber": {
          "type": "string",
          "maxLength": 40
        },
        "restaurantId": {
          "type": "string",
          "maxLength": 128
        },
        "restaurantOwnerUid": {
          "type": "string",
          "maxLength": 128
        },
        "restaurantName": {
          "type": "string",
          "maxLength": 140
        },
        "customerId": {
          "type": "string",
          "maxLength": 128
        },
        "customerName": {
          "type": "string",
          "maxLength": 120
        },
        "reference": {
          "type": "string",
          "maxLength": 80
        },
        "gateway": {
          "type": "string",
          "maxLength": 40
        },
        "type": {
          "type": "string",
          "enum": ["Charge", "Refund"],
          "maxLength": 20
        },
        "grossAmount": {
          "type": "number"
