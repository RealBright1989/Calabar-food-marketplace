  "firestore": {
    "/admins/{userId}": {
      "schema": { "$ref": "#/entities/AdminUser" },
      "description": "Admin role directory"
    },
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserSummary" },
      "description": "User role and non-PII account summary"
    },
    "/users/{userId}/private/{docId}": {
      "schema": { "$ref": "#/entities/UserPrivateInfo" },
      "description": "Isolated PII (email, phone, saved addresses)"
    },
    "/restaurants/{restaurantId}": {
      "schema": { "$ref": "#/entities/Restaurant" },
      "description": "Public restaurant profiles and vendor ownership"
    },
    "/menuItems/{menuItemId}": {
      "schema": { "$ref": "#/entities/MenuItem" },
      "description": "Marketplace dishes and availability"
    },
    "/foodCategories/{categoryId}": {
      "schema": { "$ref": "#/entities/FoodCategoryDoc" },
      "description": "Marketplace-wide food categories"
    },
    "/orders/{orderId}": {
      "schema": { "$ref": "#/entities/Order" },
      "description": "Marketplace food orders"
    },
    "/transactions/{transactionId}": {
      "schema": { "$ref": "#/entities/Transaction" },
      "description": "Immutable Paystack transaction and commission ledger"
    },
    "/vendorApplications/{applicationId}": {
      "schema": { "$ref": "#/entities/VendorApplication" },
      "description": "Vendor onboarding applications"
    },
    "/disputes/{disputeId}": {
      "schema": { "$ref": "#/entities/Dispute" },
      "description": "Customer order disputes"
    },
    "/announcements/{announcementId}": {
      "schema": { "$ref": "#/entities/Announcement" },
      "description": "Admin marketplace announcements"
    },
    "/settings/{settingId}": {
      "schema": { "$ref": "#/entities/MarketplaceSettings" },
      "description": "Global marketplace configuration"
    },
    "/activityLogs/{logId}": {
      "schema": { "$ref": "#/entities/ActivityLog" },
      "description": "Immutable administrative audit logs"
    }
  }
}
